# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# All optional. Without it the testbed runs on the synthetic profiles in
# domain.json and the report says so. These only matter when you want to
# replace a profile's placeholder numbers with real measurements.
#
# Any endpoint that speaks OpenAI-compatible chat completions works.

# Label recorded with the measurement, e.g. openai, local, self-hosted
PROVIDER_NAME=openai

# The full chat completions URL, exactly as your provider documents it
PROVIDER_URL=https://api.openai.com/v1/chat/completions

# bearer  ->  Authorization: Bearer <key>     (most providers)
# api-key ->  api-key: <key>                  (some managed cloud endpoints)
PROVIDER_AUTH=bearer

PROVIDER_API_KEY=sk-your-key-here

# Model name sent in the request body. Leave empty if your provider puts the
# model in the URL path instead.
PROVIDER_MODEL=gpt-4o-mini

# USD per 1,000 tokens, from your provider's pricing page. Responses do not
# carry a price, so cost is computed from measured tokens and these numbers.
PRICE_PER_1K_INPUT=0.00015
PRICE_PER_1K_OUTPUT=0.0006

# Which profile id in domain.json to overwrite with the measurements
CALIBRATE_PROFILE_ID=gen.strong

# Real calls, each costing money. Warmup is discarded to skip cold start.
CALIBRATE_SAMPLES=20
CALIBRATE_WARMUP=3
